+VERSION = "stage1c-baselines-v1.0.0"
+CONTEXT_SCHEMA = "stage1b-r3-context-model-v1"
+OUTSIDE = "@outside_reservoir|ETH"
+METHODS = {"BOUNDED_REACHABILITY", "POISON", "HAIRCUT"}
