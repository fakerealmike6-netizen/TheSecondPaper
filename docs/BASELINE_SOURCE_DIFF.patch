+    if family == "split_merge_shared_targets":
+        b = Builder(family, index, {"A|ETH": q})
+        b.event("seed", "seed", q, to="A")
+        for eid, amount, sender, to in (("a_b", q, "A", "B"), ("a_c", q, "A", "C"), ("b_d", q, "B", "D"), ("c_d", q, "C", "D")):
+            b.transfer(eid, amount, sender, to)
