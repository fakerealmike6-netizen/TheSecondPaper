+                (eid + ":refund", asset, op["refund"], op["refund_to"], "PROTOCOL_REFUND"),
+                (eid + ":net", asset, op["gross"] - op["refund"], None, "PROTOCOL_NET"),
+                (eid + ":output", op["output_asset"], op["output"], op["receiver"], "PROTOCOL_OUTPUT")]
