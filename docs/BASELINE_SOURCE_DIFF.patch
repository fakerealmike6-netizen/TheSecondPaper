+    def test_unsupported_and_infeasible_not_zero(self):
+        g=shared();g['initial_balances']['A|ETH']='0'
+        with self.assertRaises(ValueError):run_interval(g)
+        with self.assertRaises(ValueError):run_interval(shared(),'UNKNOWN')
